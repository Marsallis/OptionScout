# OptionScout local defaults. These values are not brokerage secrets.
# Copy to .env only if you want to override them for a non-Docker run.
# Put brokerage credentials in secrets/tastytrade.env, not in this file.

NODE_ENV=development
PORT=3180
BIND_HOST=127.0.0.1
DATA_MODE=demo
AUTH_MODE=local-owner
ENABLE_ORDER_EXECUTION=false
TELEMETRY_ENABLED=false
RUNNING_IN_DOCKER=false
TASTYTRADE_ENABLE_LIVE=false
DXLINK_LIVE_DIAGNOSTIC=false
FINDER_LIVE_SCAN=false
SMART_SCAN_LIVE=false
TASTYTRADE_SCHEDULED_SYNC=false
TASTYTRADE_TRANSACTION_LOOKBACK_DAYS=365

# Optional. When unset, the API stores SQLite under apps/api/data/.
# DATABASE_PATH=./data/optionscout.sqlite

# Optional. When unset, the API looks for secrets/tastytrade.env.
# TASTYTRADE_SECRET_FILE=./secrets/tastytrade.env
